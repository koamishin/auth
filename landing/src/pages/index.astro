gin-top:32px;flex-wrap:wrap}.hero-actions .button{margin-top:0}.button-outline{background:transparent;border:1px solid #c7cbc0;color:#20241f}.button-outline:hover{background:#e8ebe3}.button-outline span{margin-left:12px}.hero-art{height:520px;position:relative;overflow:hidden;background:#dce4d6;border-radius:12px;color:#394b3a}.art-top,.art-bottom{position:absolute;left:24px;right:24px;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.1em}.art-top{top:24px}.art-bottom{bottom:24px}.orbit{position:absolute;border:1px solid #b8c9b6;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%)}.orbit-one{width:220px;height:220px}.orbit-two{width:360px;height:360px}.orbit-three{width:500px;height:500px}.art-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;justify-items:center;gap:16px;font-size:10px;font-weight:700;letter-spacing:.12em}.art-center img{box-shadow:0 16px 32px #83957e55;border-radius:18px}.art-node{position:absolute;background:#f5f4ee;border:1px solid #c2d0bd;border-radius:999px;padding:12px 16px;font-size:10px;color:#879585;box-shadow:0 8px 24px #72876e1a}.art-node b{color:#40513f;margin-left:8px}.node-one{top:19%;left:12%}.node-two{top:38%;right:8%}.node-three{bottom:20%;left:15%}.intro{padding:32px 0 96px}.section-label{display:flex;justify-content:space-between;border-top:1px solid #d2d5ca;padding-top:24px;color:#82897d}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:end;margin:80px 0 64px}.intro h2,.faq h2,.closing h2{font-size:clamp(36px,4vw,60px);line-height:1.1;letter-spacing:-.055em}.intro h2 span,.statement h2 span{color:#899387}.intro-grid>p,.faq-grid>div>p{font-size:18px;line-height:1.65;color:#6a7267;max-width:490px}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.features article{background:#ebece4;border-radius:8px;padding:24px;min-height:280px}.feature-number{color:#929b8d}.feature-icon{font-size:30px;margin:40px 0 24px;color:#6e8269}.features h3{font-size:18px;letter-spacing:-.03em}.features p{color:#6d756a;line-height:1.6;font-size:14px;margin-top:12px;max-width:300px}.statement{background:#303d31;color:#f6f6ee}.statement-inner{padding:96px 0}.statement .eyebrow{color:#a9b8a6}.statement h2{font-size:clamp(36px,4.5vw,60px);line-height:1.15;letter-spacing:-.05em;margin:32px 0}.statement h2 span{color:#aab9a5}.statement a{font-size:14px;font-weight:700;border-bottom:1px solid #aab9a5;padding-bottom:8px}.statement a span{margin-left:32px}.faq{padding:96px 0}.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-top:80px}.faq-grid>div>p{font-size:16px;margin-top:24px}.faq-list details{border-top:1px solid #d2d5ca;padding:24px 0}.faq-list details:last-child{border-bottom:1px solid #d2d5ca}.faq-list summary{cursor:pointer;list-style:none;font-size:16px;font-weight:700;display:flex;justify-content:space-between;gap:24px}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{font-size:24px;font-weight:400;color:#81917d}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list details p{color:#6a7267;font-size:14px;line-height:1.7;margin-top:16px;max-width:520px}.closing{background:#dce4d6;border-radius:12px;padding:64px;display:flex;justify-content:space-between;align-items:end;gap:32px}.closing h2{margin-top:24px}.button-light{margin:0}.footer{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:64px 0;font-size:12px;color:#7e857a}.footer .brand{color:#20241f}.footer>a:last-child{font-weight:700;color:#434b40}@media(max-width:800px){.shell{width:min(100% - 40px,1280px)}.header{height:80px}.header nav{gap:16px}.header nav a:not(.nav-link):not(.docs-link){display:none}.hero{grid-template-columns:1fr;gap:24px;padding:24px 0 64px}.hero-copy{padding:24px 0}.hero-art{height:400px}.intro{padding-bottom:64px}.intro-grid,.faq-grid{grid-template-columns:1fr;gap:24px;margin:48px 0}.features{grid-template-columns:1fr}.features article