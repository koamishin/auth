includes:
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - routes
        - tests
    
    # Laravel-specific configurations
    excludePaths:
        - ./*/*/FileToBeExcluded.php
        - bootstrap/cache
        - storage
        - vendor
    
    # Ignore common Laravel patterns and Pest internal classes
    ignoreErrors:
        - '#Unsafe usage of new static#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder#'
        - '#Call to an undefined method Illuminate\\Database\\Query\\Builder#'
        - '#Call to method .+ of internal class Pest\\.+ from outside its root namespace Pest\.#'
        # Pest and Livewire testing proxies forward every call to the running
        # test at runtime; the fluent chain is the documented style here.
        - '#Call to an undefined method Pest\\(PendingCalls\\TestCall|Support\\HigherOrderTapProxy)#'
        - '#Call to an undefined method Livewire\\Features\\SupportTesting\\Testable#'
    
    # Report unused declarations
    reportUnmatchedIgnoredErrors: false
